+    /** Règle commune aux deux listes de parties : id existant OU "new:nom". */
+    private function partieRule(): \Closure
+    {
+        return function (string $attribute, mixed $value, \Closure $fail) {
+            if ($value === null || $value === '') {
+                return;
+            }
+
+            if (str_starts_with($value, 'new:')) {
+                $nom = trim(mb_substr($value, 4));
+                if ($nom === '' || mb_strlen($nom) > 255) {
