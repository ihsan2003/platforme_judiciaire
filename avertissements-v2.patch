+
+        unset($data['type_personne_demandeur'], $data['type_personne_defendeur']);
+
+        return $data;
+    }
+
+    private function resoudrePartie(?string $valeur, ?string $typePersonne): ?int
     {
+        if ($valeur === null || $valeur === '') {
+            return null;
+        }
+
+        if (str_starts_with($valeur, 'new:')) {
+            // Le CIN est optionnel : on ne déduplique pas, comme dans
+            // DossierPartieController@store pour une partie sans CIN.
+            return Partie::create([
